cmake_minimum_required(VERSION 3.15)
if(NOT DEFINED TEST_ROOT OR TEST_ROOT STREQUAL "")
	message(FATAL_ERROR "TEST_ROOT is required.")
endif()
if(EXISTS "${TEST_ROOT}")
	message(FATAL_ERROR "Refusing to overwrite an existing test directory: ${TEST_ROOT}")
endif()
set(script_dir "${CMAKE_CURRENT_LIST_DIR}")
set(fixture "${TEST_ROOT}/include")
set(manifest "${TEST_ROOT}/manifest.cmake")
file(MAKE_DIRECTORY "${fixture}/physics")
file(WRITE "${manifest}" "set(c_headers a.h b.h)\nset(collision_headers physics/c.h)\n")
file(WRITE "${fixture}/a.h" "")
file(WRITE "${fixture}/b.h" "")
file(WRITE "${fixture}/physics/c.h" "")

function(check_fixture expected_result expected_text)
	execute_process(COMMAND "${CMAKE_COMMAND}" "-DHEADER_ROOT=${fixture}" "-DMANIFEST_FILE=${manifest}"
		-P "${script_dir}/verify_manifest.cmake"
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
	set(combined "${output}\n${error}")
	if(expected_result STREQUAL "success")
		if(NOT result STREQUAL "0")
			message(FATAL_ERROR "Expected a matching fixture: ${combined}")
		endif()
	else()
		if(result STREQUAL "0" OR NOT combined MATCHES "${expected_text}")
			message(FATAL_ERROR "Fixture did not fail as expected (${expected_text}): ${combined}")
		endif()
	endif()
endfunction()

check_fixture(success "")
file(REMOVE "${fixture}/b.h")
check_fixture(failure "Missing:.*b\\.h")
file(WRITE "${fixture}/b.h" "")
file(WRITE "${fixture}/physics/extra.h" "")
check_fixture(failure "unexpected:.*physics/extra\\.h")
file(REMOVE "${fixture}/physics/extra.h")
file(APPEND "${manifest}" "list(APPEND c_headers a.h)\n")
check_fixture(failure "Duplicate header")
message(STATUS "Header manifest positive and negative fixtures passed. Fixture retained at ${TEST_ROOT}.")

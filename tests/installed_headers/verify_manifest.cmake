if(NOT DEFINED HEADER_ROOT OR NOT IS_DIRECTORY "${HEADER_ROOT}")
	message(FATAL_ERROR "HEADER_ROOT must identify the installed include directory.")
endif()
if(NOT DEFINED MANIFEST_FILE OR NOT EXISTS "${MANIFEST_FILE}")
	message(FATAL_ERROR "MANIFEST_FILE must identify the reviewed header manifest.")
endif()

include("${MANIFEST_FILE}")
set(expected ${c_headers} ${collision_headers})
if(NOT c_headers OR NOT collision_headers)
	message(FATAL_ERROR "The C and C++ header lists must both be nonempty.")
endif()
set(unique_expected ${expected})
list(REMOVE_DUPLICATES unique_expected)
list(LENGTH expected expected_count)
list(LENGTH unique_expected unique_count)
if(NOT expected_count EQUAL unique_count)
	message(FATAL_ERROR "Duplicate header in the manifest.")
endif()
foreach(header IN LISTS expected)
	if(NOT header MATCHES "^[A-Za-z0-9_]+(/[A-Za-z0-9_]+)*\\.h$")
		message(FATAL_ERROR "Invalid header manifest entry: ${header}")
	endif()
endforeach()

file(GLOB_RECURSE actual LIST_DIRECTORIES false RELATIVE "${HEADER_ROOT}" "${HEADER_ROOT}/*")
set(missing ${expected})
set(unexpected ${actual})
foreach(header IN LISTS actual)
	list(REMOVE_ITEM missing "${header}")
endforeach()
foreach(header IN LISTS expected)
	list(REMOVE_ITEM unexpected "${header}")
endforeach()
list(SORT missing)
list(SORT unexpected)
if(missing OR unexpected)
	message(FATAL_ERROR "Installed include surface differs from the reviewed manifest. Missing: [${missing}]; unexpected: [${unexpected}]")
endif()
message(STATUS "Installed include surface matches ${expected_count} reviewed header entries.")
